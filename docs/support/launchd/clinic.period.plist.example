<?xml version="1.0" encoding="UTF-8"?>
<!-- TEMPLATE, NOT INSTALLED. replace __REPO__ with the repository path; installing it is the owner's decision. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>clinic.period</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>-c</string><string>cd "__REPO__" &amp;&amp; .venv/bin/python period_run.py run</string></array>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/clinic.period.log</string>
  <key>StandardErrorPath</key><string>/tmp/clinic.period.log</string>
</dict>
</plist>
