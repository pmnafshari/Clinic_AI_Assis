<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the demo backend's interpreter: inherits the app's sandbox, nothing more -->
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.inherit</key><true/>
	<!-- ad-hoc signatures carry no Team ID, so the hardened runtime's library validation would refuse the bundled
	     extension modules; a Developer ID build drops this entitlement -->
	<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
